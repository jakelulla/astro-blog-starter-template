{
	"name": "jake-lulla",
	"description": "Jake Lulla's personal site and blog: Astro on Cloudflare Workers with D1 and Workers AI + Vectorize search.",
	"dependencies": {
		"@astrojs/cloudflare": "12.6.12",
		"@astrojs/mdx": "4.3.13",
		"@astrojs/rss": "4.0.14",
		"@astrojs/sitemap": "3.6.1",
		"astro": "5.16.9",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"wrangler": "4.136.1"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"build": "astro build",
		"cf-typegen": "wrangler types",
		"check": "astro build && tsc && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "astro dev",
		"preview": "astro build && wrangler dev",
		"db:migrate": "wrangler d1 migrations apply jake-lulla-db --remote",
		"db:migrate:local": "wrangler d1 migrations apply jake-lulla-db --local"
	},
	"type": "module"
}
