---
import SocialLinks from './SocialLinks.astro';
import { LINKS } from '../consts';
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Jake Lulla · Built with Astro on Cloudflare Workers ·
	<a href={LINKS.repo}>Source</a> · <a href="/rss.xml">RSS</a>
	<div class="social-links">
		<SocialLinks />
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.85em;
	}
	footer a {
		color: rgb(var(--gray));
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links :global(a) {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links :global(a:hover) {
		color: rgb(var(--gray-dark));
	}
</style>
