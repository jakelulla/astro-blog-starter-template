---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Search from '../../components/Search.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog · ${SITE_TITLE}`} description="Notes on what I'm building and what broke along the way." />
		<style>
			ul.posts {
				list-style: none;
				padding: 0;
				margin: 2em 0 0;
			}
			ul.posts li {
				margin-bottom: 2em;
			}
			ul.posts a {
				text-decoration: none;
			}
			ul.posts h2 {
				font-size: 1.4em;
				margin: 0;
			}
			ul.posts a:hover h2 {
				color: var(--accent);
			}
			ul.posts p {
				margin: 0.25em 0 0;
				color: rgb(var(--gray-dark));
			}
			time {
				color: rgb(var(--gray));
				font-size: 0.8em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			<p>Notes on what I'm building and what broke along the way.</p>
			<Search placeholder="Search posts and projects…" />
			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<FormattedDate date={post.data.pubDate} />
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
